# =================================================================================================
# Maxx Accounting Portal — environment for the VPS.
#
#   cp .env.accounting.example .env.accounting      then fill in the blanks. .env.accounting is
#   gitignored. Every variable below is read by accounting/config.py; the value after `=` here is the
#   default the code uses when the line is missing, or the real value where it is already known.
#
# Lines marked SECRET must never be pasted into chat, a ticket, or a commit.
# =================================================================================================


# ---- Hosting --------------------------------------------------------------------------------------
# Where the portal lives. Both are already decided; change only on the dedicated VPS if the name moves.
PORTAL_HOST=accounting.90ten.life
PORTAL_BASE_URL=https://accounting.90ten.life
# Cookies are Secure/HttpOnly/host-only. Leave true everywhere except a laptop on plain http.
SECURE_COOKIES=true
# production | test. `test` relaxes nothing visible — it allows the dev seal key and in-process parser.
ACCOUNTING_ENV=production


# ---- Portal database: the NEW Supabase project "maxx-accounting" (spec §5) -----------------------------
# Supabase dashboard -> project maxx-accounting -> Connect (top bar) -> "Session pooler" or "Direct
# connection" string, URI form. Paste it whole; it already contains the password. SECRET.
# Example shape: postgresql://postgres.abcdefghijkl:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
ACCOUNTING_DATABASE_URL=
ACCOUNTING_DB_POOL_MIN=1
ACCOUNTING_DB_POOL_MAX=8
# Column-encryption key for TINs and bank fingerprints (DATA-1). 32 random bytes, base64. The app
# holds it; the database never sees it, so a copy of the DB alone cannot read those columns. SECRET.
# Generate once, store in the password manager, never rotate without a re-encryption plan:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ACCOUNTING_FIELD_KEY=


# ---- Object store: originals (.eml, attachments) and renders (PNG pages) ----------------------------
# local = a directory on the VPS (testing only; compose mounts the accounting-store volume at the path
#         below and pins ACCOUNTING_STORE_DIR there, so the value here is ignored under compose).
# s3    = Supabase Storage in the maxx-accounting project through its S3-compatible endpoint.
ACCOUNTING_STORE_BACKEND=local
ACCOUNTING_STORE_DIR=var/store
# Supabase dashboard -> maxx-accounting -> Project Settings -> Storage -> "S3 Connection":
#   endpoint looks like https://abcdefghijkl.supabase.co/storage/v1/s3
#   then "New access key" gives the access key id and secret. SECRET (both).
ACCOUNTING_STORE_S3_ENDPOINT=
ACCOUNTING_STORE_BUCKET_ORIGINALS=originals
ACCOUNTING_STORE_BUCKET_RENDERS=renders
ACCOUNTING_STORE_S3_ACCESS_KEY=
ACCOUNTING_STORE_S3_SECRET_KEY=


# ---- Identity: the EXISTING MaxxDash Supabase project, used for sign-in ONLY (spec §3) --------------
# Supabase dashboard -> the MaxxDash project -> Project Settings -> API:
#   "Project URL"  -> MAXXDASH_SUPABASE_URL   (https://<ref>.supabase.co, no trailing slash)
#   "anon public"  -> MAXXDASH_SUPABASE_ANON_KEY  (the browser-safe key; the same value MaxxDash's own
#                     .env has as NEXT_PUBLIC_SUPABASE_ANON_KEY). NOT the service_role key — the portal
#                     must never hold MaxxDash's service-role key.
# Also confirm Project Settings -> JWT Signing Keys shows an ECC (P-256) or RSA key, not the legacy
# HS256 secret. The portal verifies tokens against the project's JWKS and cannot verify HS256.
MAXXDASH_SUPABASE_URL=
MAXXDASH_SUPABASE_ANON_KEY=
# Where the "Commission statements" tile sends people.
MAXXDASH_DASHBOARD_URL=https://dashboard.90ten.life
# How long the signing-key set is cached before it is fetched again (seconds).
JWKS_CACHE_SECONDS=3600
# Sessions (ID-6): 30 minutes idle, 8 hours absolute, re-check with Supabase every 60 minutes.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
SESSION_REVALIDATE_MINUTES=60
# Sign-in attempts allowed per address per 15 minutes before the form says "wait".
SIGNIN_RATE_LIMIT=10


# ---- Sibling apps shown as tiles on the landing page (spec §9) ---------------------------------------
USAGE_URL=https://usage.accounting.90ten.life
COMMISSIONS_GENERATOR_URL=https://commissions.accounting.90ten.life


# ---- Mail: the portal's own mailbox accounts@90ten.life on Hostinger (spec §4) -----------------------
# hPanel -> Emails -> 90ten.life -> create mailbox "accounts". IMAP must be on. The mailbox password
# IS the IMAP/SMTP password (Hostinger has no separate app passwords). SECRET. Hostinger refuses to
# send unless EMAIL_FROM equals SMTP_USER, so all three addresses stay identical.
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USER=accounts@90ten.life
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# How often the worker looks for new mail (seconds).
IMAP_POLL_SECONDS=60
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=accounts@90ten.life
SMTP_PASSWORD=
EMAIL_FROM=accounts@90ten.life
# INT-4, the trusted path. Mail is accepted only when it arrived from Microsoft 365 on behalf of Maxx's
# tenant; everything else that reaches accounts@ is quarantined as a direct sender.
# Host suffixes of the last hop before Hostinger (comma-separated):
FORWARDER_HOST_SUFFIXES=.outbound.protection.outlook.com,.protection.outlook.com
# The authserv-id Microsoft writes into Authentication-Results for Maxx's tenant. Read it off the
# header of the first redirected test message; it is expected to be the tenant's primary domain.
FORWARDER_AUTHSERV_ID=maxxortho.com
# Daily heartbeat range: forwarded messages per day outside [min, max] emails the Controller. Set the
# real range after week 1 of the shadow run.
HEARTBEAT_MIN_PER_DAY=1
HEARTBEAT_MAX_PER_DAY=200


# ---- People (who gets which alert) ---------------------------------------------------------------------
# The Controller: receives heartbeat alerts, the daily grants report, D+4 reassignments, digests.
CONTROLLER_EMAIL=
# Backup Controller (spec §1).
BACKUP_CONTROLLER_EMAIL=corey.perine@maxxortho.com
# System owner and AWS account owner (spec §1).
SYSTEM_OWNER_EMAIL=lenny.knobbs@maxxortho.com
# CFO: break-glass and stale-quarantine escalations.
CFO_EMAIL=
# Where "Report to security" sends. Can be the Controller until a security mailbox exists.
SECURITY_EMAIL=
# Business-day math and every time shown on screen.
ACCOUNTING_TIMEZONE=America/New_York


# ---- Parser container limits (spec §0, INT-5) ---------------------------------------------------------
# PARSER_SOCKET is pinned by docker-compose.accounting.yml to the shared volume; the value here only
# matters when running outside compose (tests use an in-process parser).
PARSER_SOCKET=var/parser.sock
# A document with more pages than this, or more bytes than this, is refused and the invoice is
# quarantined rather than parsed. 104857600 = 100 MB.
PARSER_MAX_PAGES=50
PARSER_MAX_BYTES=104857600
# Hard CPU-seconds cap per document inside the parser.
PARSER_CPU_SECONDS=60


# ---- Capture: Anthropic ONLY (spec §6 — no OpenRouter for invoices, there is no BAA) -------------------
# console.anthropic.com -> API Keys. Use the organisation that holds the BAA. SECRET.
ANTHROPIC_API_KEY=
# The everyday extractor and the model a low-confidence field is escalated to.
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_ESCALATION_MODEL=claude-opus-5-5
# Per-field confidence below this sends the field to AP review instead of accepting it.
CAPTURE_CONFIDENCE_THRESHOLD=0.85


# ---- Approvals: passkeys and the signing service (spec §7) ---------------------------------------------
# WebAuthn relying party. The RP ID must be the exact host the browser sees — change it and every
# enrolled passkey stops working.
WEBAUTHN_RP_ID=accounting.90ten.life
WEBAUTHN_RP_NAME=Maxx Accounting Portal
# Signing session: a passkey tap covers approvals under the step-up amount for this long (D3/D4).
SIGNING_SESSION_IDLE_MINUTES=15
SIGNING_SESSION_MAX_MINUTES=60
# Lambda function URL from LENNY'S AWS account (infra/signing-lambda/README.md). Empty in production
# means every approval fails closed — nothing is signed, nothing is lost.
SIGNING_SERVICE_URL=
AWS_REGION=us-east-1
# Andy's IAM user in Lenny's account: may invoke the function URL and write to the anchors bucket,
# nothing else. AWS console -> IAM -> Users -> the user -> Security credentials -> Create access key. SECRET.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# DEV ONLY. A local ECDSA P-256 private key (PEM) used as the seal when ACCOUNTING_ENV=test. Leave
# empty on the VPS; the code ignores it outside test mode anyway.
DEV_SEAL_PRIVATE_KEY_PEM=


# ---- Audit anchoring (AUD-1) ------------------------------------------------------------------------------
# S3 bucket with Object Lock (compliance mode, 7 years) in Lenny's account. Name from
# infra/signing-lambda/README.md; expected "maxx-ap-anchors".
ANCHOR_BUCKET=
# Minutes between chain-head anchors.
ANCHOR_INTERVAL_MINUTES=15


# ---- Business rules: defaults only. The live values are rows in the `config` table, changed under
#      dual control from the admin screen; these seed the first row. Amounts are integer CENTS. -------------
# $25,000 — at or above this every approval needs a fresh passkey tap (D3/D4).
STEP_UP_AMOUNT_CENTS=2500000
# Recurring-invoice auto-release tolerance, percent either side of the prior amount.
RECURRING_TOLERANCE_PCT=2.0
# $10,000 — a quarantine release above this needs a second person.
SECOND_PERSON_RELEASE_CENTS=1000000
